<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.avaloq.tools.ddk</groupId>
  <artifactId>ddk-core-parent</artifactId>
  <version>17.2.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>DDK Core Parent</name>
  <description>Parent POM for migrated core modules (jar packaging with bnd OSGi manifests).</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Align with ddk-parent versions -->
    <xtext.version>2.42.0</xtext.version>
    <emf.ecore.version>2.42.0</emf.ecore.version>
    <emf.common.version>2.45.0</emf.common.version>
    <emf.edit.version>2.23.0</emf.edit.version>
    <emf.ecore.xmi.version>2.40.0</emf.ecore.xmi.version>
    <emf.ecore.change.version>2.17.0</emf.ecore.change.version>
    <eclipse.core.runtime.version>3.34.200</eclipse.core.runtime.version>
    <eclipse.core.resources.version>3.22.200</eclipse.core.resources.version>
    <eclipse.core.jobs.version>3.15.700</eclipse.core.jobs.version>
    <eclipse.core.contenttype.version>3.9.800</eclipse.core.contenttype.version>
    <eclipse.text.version>3.14.600</eclipse.text.version>
    <eclipse.jdt.annotation.version>2.3.0</eclipse.jdt.annotation.version>
    <eclipse.jdt.core.version>3.42.0</eclipse.jdt.core.version>
    <guava.version>33.3.0-jre</guava.version>
    <guice.version>7.0.0</guice.version>
    <commons.lang3.version>3.20.0</commons.lang3.version>
    <commons.text.version>1.13.0</commons.text.version>
    <log4j.version>2.24.3</log4j.version>
    <lsp4j.version>1.0.0</lsp4j.version>
    <bnd.version>7.1.0</bnd.version>
  </properties>

  <modules>
    <module>../com.avaloq.tools.ddk</module>
    <module>../com.avaloq.tools.ddk.xtext</module>
    <module>../com.avaloq.tools.ddk.test.core</module>
    <module>../com.avaloq.tools.ddk.typesystem</module>
    <module>../com.avaloq.tools.ddk.check.runtime.core</module>
    <module>../com.avaloq.tools.ddk.check.lib</module>
    <module>../com.avaloq.tools.ddk.xtext.ide</module>
    <module>../com.avaloq.tools.ddk.xtext.common.types</module>
    <module>../com.avaloq.tools.ddk.xtext.expression</module>
    <module>../com.avaloq.tools.ddk.xtext.format</module>
    <module>../com.avaloq.tools.ddk.xtext.scope</module>
    <module>../com.avaloq.tools.ddk.xtext.valid</module>
    <module>../com.avaloq.tools.ddk.xtext.builder</module>
    <module>../com.avaloq.tools.ddk.xtext.export</module>
    <!-- xtext.generator stays in ddk-parent (has Eclipse UI deps) -->
    <module>../com.avaloq.tools.ddk.xtext.expression.ide</module>
    <module>../com.avaloq.tools.ddk.xtext.format.ide</module>
    <module>../com.avaloq.tools.ddk.xtext.scope.ide</module>
    <module>../com.avaloq.tools.ddk.xtext.valid.ide</module>
    <module>../com.avaloq.tools.ddk.xtext.export.ide</module>
    <module>../com.avaloq.tools.ddk.checkcfg.core</module>
    <module>../com.avaloq.tools.ddk.xtext.check.generator</module>
    <module>../com.avaloq.tools.ddk.xtext.export.generator</module>
    <module>../com.avaloq.tools.ddk.xtext.format.generator</module>
    <module>../com.avaloq.tools.ddk.xtext.scope.generator</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Internal -->
      <dependency>
        <groupId>com.avaloq.tools.ddk</groupId>
        <artifactId>com.avaloq.tools.ddk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.avaloq.tools.ddk</groupId>
        <artifactId>com.avaloq.tools.ddk.xtext</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Xtext -->
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext.util</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext.ide</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext.xbase</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext.xbase.ide</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext.common.types</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>org.eclipse.xtext.xtext.generator</artifactId>
        <version>${xtext.version}</version>
      </dependency>
      <!-- EMF -->
      <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.ecore</artifactId>
        <version>${emf.ecore.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.common</artifactId>
        <version>${emf.common.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.edit</artifactId>
        <version>${emf.edit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
        <version>${emf.ecore.xmi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.ecore.change</artifactId>
        <version>${emf.ecore.change.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.codegen.ecore</artifactId>
        <version>2.40.0</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.mwe2.launch</artifactId>
        <version>2.25.0</version>
      </dependency>
      <!-- Eclipse Platform -->
      <dependency>
        <groupId>org.eclipse.platform</groupId>
        <artifactId>org.eclipse.core.runtime</artifactId>
        <version>${eclipse.core.runtime.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.platform</groupId>
        <artifactId>org.eclipse.core.resources</artifactId>
        <version>${eclipse.core.resources.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.platform</groupId>
        <artifactId>org.eclipse.core.jobs</artifactId>
        <version>${eclipse.core.jobs.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.platform</groupId>
        <artifactId>org.eclipse.core.contenttype</artifactId>
        <version>${eclipse.core.contenttype.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.platform</groupId>
        <artifactId>org.eclipse.text</artifactId>
        <version>${eclipse.text.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jdt</groupId>
        <artifactId>org.eclipse.jdt.annotation</artifactId>
        <version>${eclipse.jdt.annotation.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jdt</groupId>
        <artifactId>org.eclipse.jdt.core</artifactId>
        <version>${eclipse.jdt.core.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.lsp4j</groupId>
        <artifactId>org.eclipse.lsp4j</artifactId>
        <version>${lsp4j.version}</version>
      </dependency>
      <!-- Common libraries -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.inject</groupId>
        <artifactId>guice</artifactId>
        <version>${guice.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${commons.lang3.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-text</artifactId>
        <version>${commons.text.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.classgraph</groupId>
        <artifactId>classgraph</artifactId>
        <version>4.8.174</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-maven-plugin</artifactId>
          <version>${bnd.version}</version>
          <executions>
            <execution>
              <goals><goal>bnd-process</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
          <configuration>
            <archive>
              <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
            </archive>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

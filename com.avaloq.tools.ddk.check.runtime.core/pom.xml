<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.avaloq.tools.ddk</groupId>
    <artifactId>ddk-core-parent</artifactId>
    <version>17.2.0-SNAPSHOT</version>
    <relativePath>../ddk-core-parent</relativePath>
  </parent>

  <artifactId>com.avaloq.tools.ddk.check.runtime.core</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.resources</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <dependency>
      <groupId>com.avaloq.tools.ddk</groupId>
      <artifactId>com.avaloq.tools.ddk.xtext</artifactId>
    </dependency>
    <dependency>
      <groupId>com.avaloq.tools.ddk</groupId>
      <artifactId>com.avaloq.tools.ddk</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <configuration>
          <bnd><![CDATA[
Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Vendor: Avaloq Group AG
Export-Package: \
  com.avaloq.tools.ddk.check.runtime,\
  com.avaloq.tools.ddk.check.runtime.configuration,\
  com.avaloq.tools.ddk.check.runtime.context,\
  com.avaloq.tools.ddk.check.runtime.issue,\
  com.avaloq.tools.ddk.check.runtime.label,\
  com.avaloq.tools.ddk.check.runtime.quickfix,\
  com.avaloq.tools.ddk.check.runtime.registry,\
  com.avaloq.tools.ddk.check.runtime.validation
Import-Package: *
          ]]></bnd>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

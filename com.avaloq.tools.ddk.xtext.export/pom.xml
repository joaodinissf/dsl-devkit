<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.avaloq.tools.ddk</groupId>
    <artifactId>ddk-core-parent</artifactId>
    <version>17.2.0-SNAPSHOT</version>
    <relativePath>../ddk-core-parent</relativePath>
  </parent>

  <artifactId>com.avaloq.tools.ddk.xtext.export</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <dependency>
      <groupId>com.avaloq.tools.ddk</groupId>
      <artifactId>com.avaloq.tools.ddk.xtext</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.avaloq.tools.ddk</groupId>
      <artifactId>com.avaloq.tools.ddk.xtext.expression</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.util</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.xtext.generator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.codegen.ecore</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.mwe2.launch</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.resources</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.runtime</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>src-gen</source>
                <source>xtend-gen</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <configuration>
          <bnd><![CDATA[
Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Vendor: Avaloq Group AG
Export-Package: \
  com.avaloq.tools.ddk.xtext.export,\
  com.avaloq.tools.ddk.xtext.export.export,\
  com.avaloq.tools.ddk.xtext.export.export.impl,\
  com.avaloq.tools.ddk.xtext.export.export.util,\
  com.avaloq.tools.ddk.xtext.export.parser.antlr,\
  com.avaloq.tools.ddk.xtext.export.parser.antlr.internal,\
  com.avaloq.tools.ddk.xtext.export.scoping,\
  com.avaloq.tools.ddk.xtext.export.services,\
  com.avaloq.tools.ddk.xtext.export.validation,\
  com.avaloq.tools.ddk.xtext.export.formatting,\
  com.avaloq.tools.ddk.xtext.export.serializer,\
  com.avaloq.tools.ddk.xtext.export.generator
Import-Package: *
          ]]></bnd>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
